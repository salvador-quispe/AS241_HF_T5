              "protocol": "http",
              "host": ["127", "0", "0", "1"],
              "port": "8000",
              "path": ["api", "perfil-estudiante", "distritos"],
              "query": [
                {
                  "key": "top_n",
                  "value": "6",
                  "description": "Número de distritos a mostrar (por defecto 6)"
                }
              ]
            },
            "description": "Distribución de estudiantes por distrito de procedencia. Se puede cambiar el top_n (ej: top_n=10)"
          },
          "response": []
        }
